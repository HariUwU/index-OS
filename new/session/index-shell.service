# WILL OF THE CITY :: THE INDEX — Quickshell session unit
# Runs the INDEX bar, wallpaper, notifications and start menu.
# It replaces plasma-plasmashell.service (masked by install.sh).
[Unit]
Description=THE INDEX shell (Quickshell)
PartOf=graphical-session.target
After=plasma-kwin_wayland.service

[Service]
# First login also needs the live registry: KDE creates its default keys at startup.
ExecStartPre=-/usr/bin/python3 %h/.local/share/index/bridge/configure-shortcuts.py --wait 15
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell/index
# plasmashell normally tells the splash "desktop is ready"; do it for it.
# --auto-start=no: never D-Bus-activate a fresh splash if none is showing.
ExecStartPost=-/bin/sh -c 'sleep 1.5; busctl --user --auto-start=no call org.kde.KSplash /KSplash org.kde.KSplash setStage s desktop'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=plasma-workspace.target
