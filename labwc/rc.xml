<?xml version="1.0"?>
<labwc_config>
  <core><gap>6</gap><decoration>server</decoration></core>
  <!-- drag a window to a screen edge to snap it (half / quarter) -->
  <snapping>
    <range>20</range>
    <overlay><enabled>yes</enabled><delay><inner>200</inner><outer>200</outer></delay></overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>
  <windowRules>
    <!-- force the labwc (cyan bracket) titlebar even on apps that prefer their own -->
    <windowRule identifier="*" serverDecoration="yes"/>
  </windowRules>
  <theme>
    <name>the-index</name>
    <titlebar><layout>icon:iconify,max,close</layout></titlebar>
    <font place="ActiveWindow"><name>Perfect DOS VGA 437 Universal</name><size>10</size></font>
    <font place="InactiveWindow"><name>Perfect DOS VGA 437 Universal</name><size>10</size></font>
  </theme>
  <desktops><number>5</number></desktops>
  <keyboard>
    <!-- Thai + English; Alt+Shift or Super+Space switches -->
    <layoutScope>global</layoutScope>
    <default />
    <repeatRate>30</repeatRate>
    <repeatDelay>400</repeatDelay>
    <keybind key="W-Return"><action name="Execute"><command>foot</command></action></keybind>
    <keybind key="W-d"><action name="Execute"><command>wofi --show drun</command></action></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="W-f"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-l"><action name="Execute"><command>sh -c "$HOME/.config/labwc/index-lock"</command></action></keybind>
    <!-- tap Super alone = toggle start menu -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute"><command>sh -c "qs ipc call startmenu toggle || quickshell ipc call startmenu toggle"</command></action></keybind>
    <!-- keyboard snapping -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up"/></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <!-- clipboard history -->
    <keybind key="W-v"><action name="Execute"><command>sh -c "$HOME/.config/labwc/index-clip"</command></action></keybind>
    <!-- save current display layout so it persists -->
    <keybind key="W-S-d"><action name="Execute"><command>sh -c "$HOME/.config/labwc/index-display-save; notify-send 'THE INDEX' 'display layout saved'"</command></action></keybind>
    <!-- screenshot: full screen / region -->
    <!-- Windows-style snip: select area -> editor -> save + clipboard -->
    <keybind key="W-S-s"><action name="Execute"><command>sh -c "$HOME/.local/bin/index-snip"</command></action></keybind>
    <keybind key="Print"><action name="Execute"><command>sh -c "grim ~/Pictures/index-$(date +%Y%m%d-%H%M%S).png"</command></action></keybind>
    <keybind key="S-Print"><action name="Execute"><command>sh -c "grim -g \"$(slurp)\" - | wl-copy"</command></action></keybind>
    <!-- brightness -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>brightnessctl set +5%</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>brightnessctl set 5%-</command></action></keybind>
    <!-- volume / media -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command></action></keybind>
    <keybind key="XF86AudioPlay"><action name="Execute"><command>playerctl play-pause</command></action></keybind>
    <keybind key="XF86AudioNext"><action name="Execute"><command>playerctl next</command></action></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute"><command>playerctl previous</command></action></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5"/></keybind>
  </keyboard>
  <mouse><default/></mouse>
  <libinput>
    <device category="default">
      <naturalScroll>no</naturalScroll>
      <pointerSpeed>-1.00</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
    </device>
    <device category="touchpad">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <dragLock>no</dragLock>
      <disableWhileTyping>yes</disableWhileTyping>
      <pointerSpeed>-1.00</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <scrollFactor>1.0</scrollFactor>
    </device>
  </libinput>
</labwc_config>
